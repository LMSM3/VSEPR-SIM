# IKK IV — Scale Interval, Length Scales, and Dimensional Structure
# Batch sweep: CH4 (molecular) / Si (covalent) / NaCl (ionic) / Fe (metallic).
# Theory: IKK IV §2 — field/particle/macro are representational limits, not categories.

[project]
name        = "ikk4_scale_interval_batch"
version     = "v5.1.13.5"
seed_base   = 4000
determinism = true

[batch]
print_plan = true

[[batch.job]]
name            = "molecular_scale_ch4"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "CH4"
structure = "molecular"
phase     = "gas"

[batch.job.run]
mode = "relax"
max_steps = 800
temperature = 0.0

[batch.job.environment]
periodic    = false
temperature = 0.0

[batch.job.scale_sampling]
rve_window_lengths_A = [1.0, 2.0, 4.0]
field_grid           = [4, 4, 4]

[[batch.job]]
name            = "covalent_scale_si"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Si"
prototype = "A4_Si"
cell      = "4x4x4"

[batch.job.run]
mode = "md"
max_steps = 1500
dt_fs = 0.5
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.71, 5.43, 10.86, 21.72]
field_grid           = [8, 8, 8]

[[batch.job]]
name            = "ionic_scale_nacl"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "NaCl"
prototype = "B1_NaCl"
cell      = "4x4x4"

[batch.job.run]
mode = "md"
max_steps = 1500
dt_fs = 1.0
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.82, 5.64, 11.28, 22.56]
field_grid           = [8, 8, 8]

[[batch.job]]
name            = "metallic_scale_fe"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Fe"
prototype = "A2_Fe"
cell      = "4x4x4"

[batch.job.run]
mode = "md"
max_steps = 1500
dt_fs = 1.0
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.48, 4.96, 9.92, 19.84]
field_grid           = [8, 8, 8]

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
rve_windows_per_level            = 6
rve_window_placement             = "grid"
min_particles_for_scale_sampling = 16
spatial_cv_threshold             = 0.35
temporal_drift_threshold         = 0.20
scale_drift_threshold            = 0.30
scale_drift_metric               = "successive_window_difference"

[analysis.structure]
enabled           = true
neighbor_cutoff_A = 6.0
contact_cutoff_A  = 3.5

[analysis.sampling]
enabled     = true
compute_rdf = true
compute_msd = true
unwrap_pbc  = true

[analysis.inference]
enabled = true
mode    = "rule_based_61d"

[observe]
metrics       = ["energy_map", "coordination", "rdf"]
output_format = "json"
every_n_steps = 50

[kernel]
pass_through   = true
symbolic_trace = true
event_registry = true

[verify]
enabled             = true
profile             = "ikk4_scale_ladder_batch"
write_verify_report = true
write_verify_tsv    = true

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

[export]
write_xyz           = true
write_analysis_json = true
write_metrics_tsv   = true
write_report_md     = true
write_manifest_json = true
output_dir          = "out/ikk4_batch"

[report]
title                   = "IKK IV — Scale Interval Batch: CH4/Si/NaCl/Fe"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true

[visual]
output_type      = "terminal_overlay_cycle"
render_interval  = 50
show_bar_chart   = true
show_proxy_table = true
overlay_sequence = energy_map,coordination
