# MIR III — Recovery Efficiency and Validity
# Graphene 4×4×1 temperature sweep: 0K / 300K / 900K.
# Theory: MIR III §4-7 — η_rep vs temperature; entropy as recoverability loss.
# Cross-scale: spatial_cv and scale_drift_fraction rise with T, tracking 𝔇 degradation.
# Note: wic1 uses 8×8×1 at 300K. This uses 4×4×1 at three T values for efficiency comparison.

[project]
name        = "mir3_recovery_efficiency_graphene"
version     = "v5.1.13.5"
seed_base   = 2300
determinism = true

[batch]
print_plan = true

# ─── Job 1: 0K baseline — maximum recoverability, minimal entropy ─────────────

[[batch.job]]
name            = "graphene_0k_baseline"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "C"
structure = "graphene"
cell      = "4x4x1"
phase     = "solid"

[batch.job.run]
mode        = "md"
max_steps   = 2000
dt_fs       = 0.25
temperature = 0.0
converge    = false

[batch.job.environment]
periodic    = true
temperature = 0.0
medium      = "vacuum"

[batch.job.scale_sampling]
rve_window_lengths_A = [1.42, 2.46, 4.92, 9.84]
field_grid           = [6, 6, 2]
spatial_cv_threshold = 0.20
# Expect: low spatial_cv, low scale_drift → high η_rep proxy

# ─── Job 2: 300K ambient — reference operating point ──────────────────────────

[[batch.job]]
name            = "graphene_300k_ambient"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "C"
structure = "graphene"
cell      = "4x4x1"
phase     = "solid"

[batch.job.run]
mode        = "md"
max_steps   = 2000
dt_fs       = 0.25
temperature = 300
converge    = false

[batch.job.environment]
periodic    = true
temperature = 300
medium      = "vacuum"

[batch.job.scale_sampling]
rve_window_lengths_A = [1.42, 2.46, 4.92, 9.84]
field_grid           = [6, 6, 2]
spatial_cv_threshold = 0.35

# ─── Job 3: 900K high-T — significant vibrational entropy, degraded recoverability ─

[[batch.job]]
name            = "graphene_900k_high_temp"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "C"
structure = "graphene"
cell      = "4x4x1"
phase     = "solid"

[batch.job.run]
mode        = "md"
max_steps   = 2000
dt_fs       = 0.25
temperature = 900
converge    = false

[batch.job.environment]
periodic    = true
temperature = 900
medium      = "vacuum"

[batch.job.scale_sampling]
rve_window_lengths_A = [1.42, 2.46, 4.92, 9.84]
field_grid           = [6, 6, 2]
spatial_cv_threshold = 0.60
# Expect: spatial_cv elevated, possible scale_drift → η_rep degraded
# Note: verify.msd may report elevated MSD at 900K — this is a valid MIR III result,
# not a failure. Entropy increase is the signal, not the error.

# ─── Global analysis (applies to all jobs) ────────────────────────────────────

[pbc]
minimum_image = true
track_images  = true

[boundary]
x = "periodic"
y = "periodic"
z = "open"

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
rve_windows_per_level            = 6
rve_window_placement             = "grid"
min_particles_for_scale_sampling = 16
temporal_drift_threshold         = 0.20
scale_drift_threshold            = 0.30
scale_drift_metric               = "successive_window_difference"

[analysis.structure]
enabled           = true
neighbor_cutoff_A = 3.5
contact_cutoff_A  = 1.8

[analysis.sampling]
enabled     = true
compute_rdf = true
compute_msd = true
unwrap_pbc  = true

[analysis.inference]
enabled = true
mode    = "rule_based_61d"

[observe]
metrics       = ["energy_map", "coordination", "rdf"]
output_format = "json"
every_n_steps = 20

[kernel]
pass_through   = true
symbolic_trace = true
event_registry = true

[kernel.trace]
formation_events = true
dynamic_energy   = true

# ─── Verification ─────────────────────────────────────────────────────────────

[verify]
enabled             = true
profile             = "mir3_graphene_recovery_sweep"
write_verify_report = true
write_verify_tsv    = true

[verify.structure]
enabled                      = true
expected_coordination        = 3
coordination_tolerance       = 0
expected_nearest_neighbor_A  = 1.42
nearest_neighbor_tolerance_A = 0.10

[verify.rdf]
enabled            = true
expected_peaks_A   = [1.42, 2.46, 2.84]
peak_tolerance_A   = 0.15
require_peak_order = true

[verify.msd]
enabled              = true
expect_bounded_solid = true
max_msd_A2           = 4.0       # relaxed: 900K job may reach ~3.5 Å² (valid MIR III signal)
max_slope_late       = 0.005
# Theory note: elevated MSD at 900K confirms entropy increase → 𝔇 loss.
# This is the measurement, not the failure.

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

# ─── Export and reporting ──────────────────────────────────────────────────────

[export]
write_xyz                 = true
write_analysis_json       = true
write_metrics_tsv         = true
write_report_md           = true
write_scale_sampling_json = true
write_events_json         = true
write_manifest_json       = true
output_dir                = "out/mir3_graphene"

[report]
title                   = "MIR III — Recovery Efficiency: Graphene 0K/300K/900K"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true
include_symbolic_trace  = true

[visual]
output_type      = "terminal_overlay_cycle"
render_interval  = 20
show_bar_chart   = true
show_proxy_table = true
show_event_timeline = true
overlay_sequence = energy_map,coordination,rdf
