# IKK III — Matrix Mechanics / Wave Function Bridge
# Si diamond cubic under laser excitation.
# Theory: IKK III §2-6 — ψ is projected identity, not primitive wave substance.
# Test: same seed → same spectral output. spectral_response is post-convergence only.

[project]
name        = "ikk3_matrix_wave_bridge_si"
version     = "v5.1.13.5"
seed_base   = 2048
determinism = true

[material]
formula   = "Si"
prototype = "A4_Si"
cell      = "6x6x6"

[run]
mode         = "md"
max_steps    = 3000
dt_fs        = 0.5
temperature  = 300
converge     = false
output_level = "verbose"

[environment]
periodic    = true
temperature = 300
medium      = "vacuum"

[pbc]
minimum_image = true
track_images  = true

[excite.laser]
axis             = "z"
polarization     = "x"
intensity        = 1.2
pulse_width_fs   = 80.0
photon_energy_eV = 3.4
fluence          = 0.05
profile          = "gaussian"

[observe]
metrics       = ["energy_map", "interference", "spectral_response", "coordination", "rdf"]
output_format = "json"
every_n_steps = 25

[kernel]
pass_through   = true
symbolic_trace = true
event_registry = true

[kernel.trace]
formation_events = true
defect_events    = true
dynamic_energy   = true

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
field_grid                       = [10, 10, 10]
rve_window_lengths_A             = [5.43, 10.86, 21.72, 43.44]
rve_windows_per_level            = 8
rve_window_placement             = "grid"
min_particles_for_scale_sampling = 64
spatial_cv_threshold             = 0.35
temporal_drift_threshold         = 0.20
scale_drift_threshold            = 0.30
scale_drift_metric               = "successive_window_difference"

[analysis.structure]
enabled           = true
neighbor_cutoff_A = 6.0
contact_cutoff_A  = 2.8

[analysis.sampling]
enabled     = true
compute_rdf = true
compute_msd = true
unwrap_pbc  = true

[analysis.inference]
enabled = true
mode    = "rule_based_61d"

[verify]
enabled             = true
profile             = "ikk3_si_laser_excite"
write_verify_report = true
write_verify_tsv    = true

[verify.structure]
enabled                      = true
expected_prototype           = "A4_Si"
expected_coordination        = 4
coordination_tolerance       = 0
expected_nearest_neighbor_A  = 2.35
nearest_neighbor_tolerance_A = 0.12

[verify.rdf]
enabled            = true
expected_peaks_A   = [2.35, 3.84, 4.50]
peak_tolerance_A   = 0.18
require_peak_order = true

[verify.msd]
enabled              = true
expect_bounded_solid = true
max_msd_A2           = 3.5
max_slope_late       = 0.002

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

[export]
write_xyz                 = true
write_analysis_json       = true
write_metrics_tsv         = true
write_report_md           = true
write_events_json         = true
write_symbolic_trace_json = true
write_dashboard_svg       = true
write_manifest_json       = true
output_dir                = "out/ikk3_si"

[report]
title                   = "IKK III — Matrix-Wave Bridge: Si + Laser"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true
include_symbolic_trace  = true

[visual]
output_type      = "terminal_overlay_cycle"
render_interval  = 50
show_event_timeline = true
show_symbolic_trace = true
overlay_sequence = energy_map,spectral_response,interference,coordination
