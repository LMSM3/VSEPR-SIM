# MIR III — Recovery Efficiency and Validity
# Si diamond cubic temperature sweep: 0K / 300K / 900K.
# Theory: MIR III §4-7 — η_{ab} vs temperature; entropy as recoverability loss.

[project]
name        = "mir3_recovery_efficiency_si"
version     = "v5.1.13.5"
seed_base   = 3030
determinism = true

[batch]
print_plan = true

[[batch.job]]
name            = "t0_ground_state_max_efficiency"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Si"
prototype = "A4_Si"
cell      = "6x6x6"

[batch.job.run]
mode = "relax"
max_steps = 1000
temperature = 0.0
converge = true

[batch.job.environment]
periodic    = true
temperature = 0.0

[batch.job.scale_sampling]
rve_window_lengths_A = [2.71, 5.43, 10.86, 21.72]
spatial_cv_threshold = 0.20

[[batch.job]]
name            = "t300_thermal_standard_efficiency"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Si"
prototype = "A4_Si"
cell      = "6x6x6"

[batch.job.run]
mode = "md"
max_steps = 2000
dt_fs = 0.5
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.71, 5.43, 10.86, 21.72]
spatial_cv_threshold = 0.30

[[batch.job]]
name            = "t900_high_temp_degraded_efficiency"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Si"
prototype = "A4_Si"
cell      = "6x6x6"

[batch.job.run]
mode = "md"
max_steps = 2000
dt_fs = 0.5
temperature = 900

[batch.job.environment]
periodic    = true
temperature = 900

[batch.job.scale_sampling]
rve_window_lengths_A = [2.71, 5.43, 10.86, 21.72]
spatial_cv_threshold = 0.50

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
field_grid                       = [8, 8, 8]
rve_windows_per_level            = 6
rve_window_placement             = "grid"
min_particles_for_scale_sampling = 64
temporal_drift_threshold         = 0.20
scale_drift_threshold            = 0.25
scale_drift_metric               = "successive_window_difference"

[analysis.structure]
enabled           = true
neighbor_cutoff_A = 5.5
contact_cutoff_A  = 2.5

[analysis.sampling]
enabled     = true
compute_rdf = true
compute_msd = true
unwrap_pbc  = true

[analysis.inference]
enabled = true
mode    = "rule_based_61d"

[observe]
metrics       = ["energy_map", "coordination", "rdf"]
output_format = "json"
every_n_steps = 40

[kernel]
pass_through   = true
symbolic_trace = true
event_registry = true

[kernel.trace]
dynamic_energy = true
defect_events  = true

[verify]
enabled             = true
profile             = "mir3_recovery_efficiency_si"
write_verify_report = true
write_verify_tsv    = true

[verify.structure]
enabled                      = true
expected_prototype           = "A4_Si"
expected_coordination        = 4
coordination_tolerance       = 1
expected_nearest_neighbor_A  = 2.35
nearest_neighbor_tolerance_A = 0.15

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

[export]
write_xyz                 = true
write_analysis_json       = true
write_metrics_tsv         = true
write_report_md           = true
write_scale_sampling_json = true
write_manifest_json       = true
output_dir                = "out/mir3_si_efficiency"

[report]
title = "MIR III — Recovery Efficiency Si: 0K/300K/900K"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true

[visual]
output_type      = "terminal_overlay_cycle"
render_interval  = 40
show_bar_chart   = true
overlay_sequence = energy_map,coordination,rdf
