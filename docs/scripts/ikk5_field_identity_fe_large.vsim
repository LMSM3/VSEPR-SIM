# IKK V — Field Identity and the Infinite-Radius Limit
# Fe BCC batch: 4x4x4 → 8x8x8 → 16x16x16.
# Theory: IKK V §2-3 — F = lim r_P→∞ P(r_P). Field is large-radius identity limit.
# Key signal: spatial_cv at largest window → 0 as cell size increases.

[project]
name        = "ikk5_field_identity_fe_large"
version     = "v5.1.13.5"
seed_base   = 5000
determinism = true

[batch]
print_plan = true

[[batch.job]]
name            = "cell_4x4x4_particle_scale"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Fe"
prototype = "A2_Fe"
cell      = "4x4x4"

[batch.job.run]
mode = "md"
max_steps = 1500
dt_fs = 1.0
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.48, 4.96, 7.44, 10.0]
field_grid           = [8, 8, 8]

[batch.job.verify.structure]
enabled                     = true
expected_coordination       = 8
coordination_tolerance      = 0
expected_nearest_neighbor_A = 2.48
nearest_neighbor_tolerance_A = 0.10

[[batch.job]]
name            = "cell_8x8x8_transition_scale"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Fe"
prototype = "A2_Fe"
cell      = "8x8x8"

[batch.job.run]
mode = "md"
max_steps = 1500
dt_fs = 1.0
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.48, 4.96, 9.92, 19.84]
field_grid           = [8, 8, 8]

[batch.job.verify.structure]
enabled                     = true
expected_coordination       = 8
coordination_tolerance      = 0
expected_nearest_neighbor_A = 2.48
nearest_neighbor_tolerance_A = 0.10

[[batch.job]]
name            = "cell_16x16x16_field_limit"
seed_count      = 1
per_run_actions = ["analyze.variance", "export"]

[batch.job.material]
formula   = "Fe"
prototype = "A2_Fe"
cell      = "16x16x16"

[batch.job.run]
mode = "md"
max_steps = 1000
dt_fs = 1.0
temperature = 300

[batch.job.environment]
periodic    = true
temperature = 300

[batch.job.scale_sampling]
rve_window_lengths_A = [2.48, 9.92, 22.96, 44.0]
field_grid           = [8, 8, 8]

[batch.job.verify.structure]
enabled                     = true
expected_coordination       = 8
coordination_tolerance      = 0
expected_nearest_neighbor_A = 2.48
nearest_neighbor_tolerance_A = 0.10

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
rve_windows_per_level            = 6
rve_window_placement             = "grid"
min_particles_for_scale_sampling = 64
spatial_cv_threshold             = 0.30
temporal_drift_threshold         = 0.15
scale_drift_threshold            = 0.25
scale_drift_metric               = "successive_window_difference"

[analysis.structure]
enabled           = true
neighbor_cutoff_A = 5.0
contact_cutoff_A  = 3.0

[analysis.sampling]
enabled     = true
compute_rdf = true
compute_msd = true
unwrap_pbc  = true

[analysis.inference]
enabled = true
mode    = "rule_based_61d"

[observe]
metrics       = ["energy_map", "coordination", "rdf"]
output_format = "json"
every_n_steps = 50

[kernel]
pass_through   = true
symbolic_trace = true
event_registry = true

[kernel.trace]
dynamic_energy = true

[verify]
enabled             = true
profile             = "ikk5_field_limit_fe"
write_verify_report = true
write_verify_tsv    = true

[verify.rdf]
enabled            = true
expected_peaks_A   = [2.48, 2.87, 4.05]
peak_tolerance_A   = 0.15
require_peak_order = true

[verify.msd]
enabled              = true
expect_bounded_solid = true
max_msd_A2           = 2.5
max_slope_late       = 0.002

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

[export]
write_xyz                 = true
write_analysis_json       = true
write_metrics_tsv         = true
write_report_md           = true
write_scale_sampling_json = true
write_manifest_json       = true
output_dir                = "out/ikk5_fe_field_limit"

[report]
title = "IKK V — Field Identity Fe: 4x4x4 → 8x8x8 → 16x16x16"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true

[visual]
output_type      = "terminal_overlay_cycle"
render_interval  = 50
show_bar_chart   = true
show_proxy_table = true
overlay_sequence = energy_map,coordination
