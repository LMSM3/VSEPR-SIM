# GR-1A: cryogenic quench display, reduced Lennard-Jones argon-like analog
run_id = GR-1A-cryogenic-quench
scenario_version = 1.0
particle_count = 64
species = Ar
molecular_identity = argon-like Lennard-Jones particle
technique = cryogenic quench under deterministic volume compression
random_seed = 20250308
initial_coordinates = deterministic jittered 4x4x4 grid in periodic cube
initial_velocities = deterministic seed-derived zero-momentum distribution
initial_temperature = 1.20
target_temperature = 0.68
box_length = 12.0
final_box_fraction = 0.48
volume_constraint = isotropic deterministic compression to final_box_fraction over first half of run
timestep = 0.002
total_steps = 12000
sample_interval = 20
checkpoint_step = 6000
integrator = velocity-verlet
interaction_model = Lennard-Jones 12-6 shifted-force cutoff
ensemble = NVT deterministic velocity-rescale
sigma = 1.0
epsilon = 1.0
cutoff = 2.5
thermostat_relaxation = 0.02
relative_residual_tolerance = 0.04
momentum_tolerance = 1e-10
energy_drift_tolerance = 10.0
restart_position_tolerance = 1e-12
restart_velocity_tolerance = 1e-12
minimum_density_ratio = 1.10
minimum_dominant_cluster_fraction = 0.80
maximum_dispersion = 3.00
maximum_mean_squared_displacement = 100.0
maximum_rdf_change = 0.20
maximum_temperature_spread = 0.12
maximum_pressure_spread = 12.0
hold_samples = 20
render_fps = 60
frame_export_cadence = every deterministic trajectory sample; timestamped at 60 fps
