[project]
name        = "floweros_minimal_water"
version     = "v5.14.1"
seed_base   = 13001
determinism = true
description = "Minimal deterministic water formation and short MD smoke run"

[simulation]
box_size_ang     = 30.0
periodic         = false
fire_max_steps   = 80
fire_dt_fs       = 0.5
formation_preset = "molecular"
step_delay_ms    = 0

[[simulation.molecule]]
formula     = "H2O"
count       = 8
temperature = 298.0
lattice     = "none"

[environment]
temperature = 298.0
pressure    = 0.0
medium      = "vacuum"
periodic    = false

[run]
mode         = "md_nvt"
max_steps    = 40
dt_fs        = 0.5
temperature  = 298.0
converge     = true
output_level = "standard"

[verify]
enabled = true

[verify.mass]
enabled   = true
max_drift = 1e-10

[export]
write_xyz           = true
write_analysis_json = true
write_metrics_tsv   = true
write_events_json   = true
output_dir          = "out/floweros_minimal_water"

[visual]
output_type            = "terminal_chart"
render_interval        = 10
show_convergence_trace = true
animation_mode         = "static"
