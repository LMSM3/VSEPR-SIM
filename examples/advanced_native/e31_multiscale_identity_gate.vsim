# E31 - Multiscale field/RVE analysis with derived IKK identity outputs.
# Identity outputs are analysis sidecars and never feed the force kernel.

[project]
name        = "e31_multiscale_identity_gate"
version     = "v5.14.1-examples-1"
seed_base   = 31031
determinism = true
description = "BCC iron multiscale readiness and derived identity gate"

[example]
catalog_id        = "E31"
compatibility     = "SUPPORTED_PIPELINE_PARTIAL_RUNNER_DISPATCH"
execution_surface = "vsepr validate; pipeline library"
primary_reference = "VSIM_REFERENCE.md analysis pipeline and IKK sections"
truth_boundary    = "ivec_and_ikk_outputs_are_derived_sidecars_only"

[material]
formula   = "Fe"
prototype = "A2_bcc"
cell      = "5x5x5"
phase     = "solid"

[cell]
type  = "orthorhombic"
lx    = 14.33
ly    = 14.33
lz    = 14.33
units = "angstrom"

[boundary]
x = "periodic"
y = "periodic"
z = "periodic"

[pbc]
minimum_image        = true
wrap_positions       = "after_step"
track_images         = true
unwrap_for_diffusion = true

[simulation]
box_size_ang     = 14.33
periodic         = true
fire_max_steps   = 800
fire_dt_fs       = 0.5
formation_preset = "metallic"
use_ewald        = false

[[simulation.molecule]]
formula       = "Fe"
count         = 250
temperature_K = 300.0
lattice       = "bcc"

[run]
mode         = "relax"
max_steps    = 800
dt_fs        = 0.5
temperature  = 300.0
converge     = true
output_level = "verbose"

[environment]
periodic    = true
temperature = 300.0
pressure    = 0.0
medium      = "vacuum"

[observe]
metrics       = ["formation", "energy_map", "coordination"]
output_format = "json"
every_n_steps = 20

[analysis.structure]
enabled              = true
compute_coordination = true
compute_packing      = true
compute_displacement = true
compute_anisotropy   = true
neighbor_cutoff_A    = 3.2
contact_cutoff_A     = 2.7

[analysis.sampling]
enabled               = true
compute_rdf           = true
compute_msd           = true
min_frames_for_motion = 10
min_frames_for_msd    = 20
unwrap_pbc            = true

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
field_grid                       = [10, 10, 10]
rve_window_lengths_A             = [2.48, 4.96, 7.00]
rve_windows_per_level            = 12
rve_window_placement             = "stratified"
min_particles_for_scale_sampling = 128
spatial_cv_threshold             = 0.22
temporal_drift_threshold         = 0.10
scale_drift_threshold            = 0.18
temporal_drift_metric            = "block_difference"
scale_drift_metric               = "successive_window_difference"

[analysis.inference]
enabled                                     = true
mode                                        = "rule_based_61d"
infer_packing_regime                        = true
infer_mobility_regime                       = true
infer_anisotropy_regime                     = true
infer_structural_stability                  = true
infer_macro_readiness                       = true
min_particles_macro_candidate               = 128
min_frames_macro_candidate                  = 20
minimum_available_metrics_for_macro_ready   = 4

[analysis.ikk_end_tag]
enabled           = true
emit_markdown     = true
emit_latex        = false
d_pass_threshold  = 0.70
d_warn_threshold  = 0.40
scale_regime      = "S_mat"
section_reference = "E31"

[analysis.ivec]
enabled       = true
write_json    = true
include_delta = true
include_var   = true
output_dir    = "out/advanced_native/e31/identity"

[verify]
enabled             = true
profile             = "e31_bcc_fe_multiscale"
write_verify_report = true
write_verify_tsv    = true

[verify.structure]
enabled                      = true
expected_prototype           = "A2_bcc"
expected_coordination        = 8
coordination_tolerance       = 1
expected_nearest_neighbor_A  = 2.482
nearest_neighbor_tolerance_A = 0.15

[verify.mass]
enabled            = true
relative_tolerance = 1e-10

[output]
output_dir                 = "out/advanced_native/e31/pipeline"
output_prefix              = "e31"
write_structure_json       = true
write_sampling_json        = true
write_scale_sampling_json  = true
write_inference_json       = true
write_sampling_manifest    = true

[export]
write_xyz                  = true
write_xyzf                 = true
write_xyzfull              = true
write_analysis_json        = true
write_metrics_tsv          = true
write_events_json          = true
write_report_md            = true
write_manifest_json        = true
write_pipeline_audit_jsonl = true
output_dir                 = "out/advanced_native/e31"

[report]
title                   = "E31 Multiscale Identity Gate"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true
include_symbolic_trace  = true

[visual]
output_type     = "none"
gl_auto_orbit   = false
render_interval = 20

[open]
enabled = false

