print_console "Day 84 - VSEPR Revival Arc"
print_console "Work Order: WO-84D"
print_console "Status: GOAL_ONLY"
print_console "Purpose: test bond order and aromaticity provider behavior"
print_console "Expected: benzene aromatic, cyclobutadiene flagged non-aromatic or unstable"
print_console "Known gaps: unsupported ring systems should fail visibly, not silently"
print_console ""
print_console ">> BondOrderProvider infers orders by valence-deficit pi assignment"
print_console ">> single 1.0, double 2.0, triple 3.0; benzene -> 3 alternating C=C (Kekule)"
print_console ">> Aromaticity is GATED via Huckel 4n+2, not guessed"
print_console ">> benzene -> aromatic (6 pi e-);  pyridine -> aromatic heterocycle"
print_console ">> cyclobutadiene -> antiaromatic (4 pi e-, 4n)"
print_console ">> acetone -> carbonyl C=O recognised;  ethene -> C=C;  ethane -> single only"
print_console ">> d8 metals (Ni/Pd/Pt(II), Au(III), Rh/Ir(I)) -> square-planar branch"
print_console ">> unsupported ring conjugation reports Unsupported (visible failure)"
print_console ""
print_console ">> Provider/fallback: bond orders and aromaticity are deterministic fallbacks"
print_console ">> Future regression target: CTest Group 102"

# ----------------------------------------------------------------------------
# [project]  --  identity block
# ----------------------------------------------------------------------------

[project]
name        = "wo84d_aromatic_bondorder_goal"
description = "Day 84 WO-84D: bond-order inference + Huckel aromaticity gate"
version     = "1.0.0"
author      = "VSEPR-SIM Day 84 arc"
tags        = "day84 wo-84d bond_order aromaticity huckel d8 goal_only print_console"
seed_base   = 8404

# ----------------------------------------------------------------------------
# [formula]  --  molecular identity for the classifiers
# ----------------------------------------------------------------------------
# benzene (C6H6):
#   - 6-membered carbon ring with 3 alternating C=C double bonds (Kekule)
#   - 6 pi electrons -> Huckel 4n+2 (n=1) -> AROMATIC
#   - cyclobutadiene (C4H4) would be 4 pi electrons -> ANTIAROMATIC (4n)

[formula]
formula = "C6H6"

print_console ">> Declared benzene C6H6: expect aromatic_ring_count 1, 3 C=C ring doubles"
print_console ">> GOAL_ONLY: cyclobutadiene/pyridine/d8 cases are covered by Group 102 tests"
