# ----------------------------------------------------------------------------
# [project]  --  identity block
# ----------------------------------------------------------------------------

[project]
name        = "wo84b_lonepair_geometry_goal"
description = "Day 84 WO-84B: element lone-pair provider drives VSEPR geometry"
version     = "1.0.0"
author      = "VSEPR-SIM Day 84 arc"
tags        = "day84 wo-84b lone_pair vsepr noble_gas goal_only print_console"
seed_base   = 8402

# ----------------------------------------------------------------------------
# [formula]  --  molecular identity for the classifiers
# ----------------------------------------------------------------------------
# XeF4 (xenon tetrafluoride):
#   - Centre: Xe (Z=54), 4 bonded F ligands, 2 lone pairs -> AX4E2
#   - VSEPR:  square planar  (this is the WO-84B headline geometry)
#   - Without the noble-gas-aware provider, this used to collapse toward a
#     generic tetrahedral answer; the provider prevents that.

[formula]
formula = "XeF4"

print_console ">> Declared XeF4: expect square planar via AX4E2"
print_console ">> GOAL_ONLY: heavy noble gas warning paths are documented, not yet exhaustive"
