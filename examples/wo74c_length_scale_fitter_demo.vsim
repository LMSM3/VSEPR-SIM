# =============================================================================
# wo74c_length_scale_fitter_demo.vsim
#
# WO-74C  --  Length Scale Fitter Validation Demonstration
#
# Exercises LengthScaleFitter (src/multiscale/length_scale_fitter.cpp)
# across all four fitting modes defined in WO-73D:
#
#   LINEAR      --  piecewise-linear interpolation of R_X(L), then root-find
#   SPLINE      --  natural cubic spline interpolation, then root-find
#   LOG         --  fit in log(L) space, then invert
#   ASYMMETRIC  --  separate above/below-ideal penalty; 2x hard weight for
#                   under-resolved (L < Lambda_X) per asymmetry rule (WO-73D)
#
# Asymmetry rule (WO-73D -- not symmetric):
#   L > Lambda_X  =>  weaker recovery (above-ideal)   -- soft penalty
#   L < Lambda_X  =>  under-resolved                  -- hard penalty (2x)
#
# Recovery curve target:
#   R_X(L) = A_X(L) / A_X(inf)
#   Lambda_X = R_X^{-1}(1 - 1/e)  ~= 0.6321
#
# Pipeline path:
#   [run] FIRE relaxation of graphene (hexagonal carbon, 5 layers)
#     -> [analysis.scale_sampling] RVE at 6 window lengths
#     -> LengthScaleFitter (all 4 modes; fit_mode field selects the default)
#     -> Lambda_nm written to metrics_tsv + analysis_json
#     -> gap_classifier ("threshold") stamps gap_label on each record
#
# Analytic fixture note (matches test_length_scale_fitter.cpp Group 78):
#   Lambda_true = 1.40 nm  (graphene inter-layer / in-plane length scale)
#   R_X(L) = 1 - exp(-L / 1.40)
#   Linear and spline modes should recover Lambda_X within 0.05 nm.
#   Log mode within 0.08 nm.  Asymmetric within 0.06 nm.
#
# Run:
#   vsper run examples/wo74c_length_scale_fitter_demo.vsim
#
# v5.13.3  |  WO-74C
# =============================================================================

[project]
name        = "wo74c_length_scale_fitter_demo"
version     = "v5.13.3"
seed_base   = 7402
determinism = true
description = "WO-74C: LengthScaleFitter four modes, graphene 5-layer, asymmetry rule"

# -- Simulation box -----------------------------------------------------------

[simulation]
box_size_ang     = 50.0
periodic         = true
fire_max_steps   = 500
fire_dt_fs       = 0.5
formation_preset = "ceramic"
step_delay_ms    = 0

[cell]
lx = 50.0
ly = 50.0
lz = 50.0

[boundary]
x = "periodic"
y = "periodic"
z = "periodic"

# 5-layer AB Bernal graphite -- canonical test system for scale_sampling
# (layer spacing 3.35 A -> Lambda_X ~ 1.40 nm cross-layer)
[[simulation.molecule]]
formula       = "C"
count         = 480
temperature_K = 300.0
lattice       = "hexagonal"
layer_mode    = "AB"
n_layers      = 5

# -- Run ----------------------------------------------------------------------

[run]
mode         = "md_nve"
max_steps    = 800
dt_fs        = 0.5
converge     = true
output_level = "standard"

# -- Scale sampling: RVE windows covering sub-nm to 3 nm range ----------------
# Window lengths chosen to bracket Lambda_true = 1.40 nm on both sides:
#   5, 8, 12, 16, 20, 28 Angstrom  =  0.5, 0.8, 1.2, 1.6, 2.0, 2.8 nm
# fit_mode selects which LengthScaleFitter strategy runs as the primary.
# All four modes are recorded in the analysis_json under fit_results[].

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = false
field_grid                       = [8, 8, 8]
min_particles_for_scale_sampling = 64
rve_window_lengths_A             = [5.0, 8.0, 12.0, 16.0, 20.0, 28.0]
rve_windows_per_level            = 16
rve_window_placement             = "stratified"
temporal_drift_metric            = "block_difference"
scale_drift_metric               = "successive_window_difference"
spatial_cv_threshold             = 0.20
temporal_drift_threshold         = 0.10
scale_drift_threshold            = 0.15

# fit_mode: primary fitting mode for Lambda_nm reported in metrics.
# Values: "linear" | "spline" | "log" | "asymmetric"
# The analysis_json includes all four modes under fit_results[].
fit_mode                         = "asymmetric"

# Analytic fixture tolerances (matched to test_length_scale_fitter.cpp Group 78)
fit_tolerance_nm                 = 0.06
fit_expected_lambda_nm           = 1.40

# -- Analysis inference -------------------------------------------------------

[analysis.inference]
enabled                    = true
mode                       = "rule_based_61d"
infer_packing_regime       = true
infer_mobility_regime      = false
infer_structural_stability = true
infer_macro_readiness      = false

# -- Verify -------------------------------------------------------------------

[verify]
enabled = true

[verify.structure]
enabled                 = true
check_coordination      = true
expected_coordination   = 3
coordination_tolerance  = 1

[verify.mass]
enabled   = true
max_drift = 1e-10

# Gap classifier: threshold strategy on the recovered Lambda_nm
# good_match expected: |Lambda_fit - prior| <= 0.05 nm
gap_strategy       = "threshold"
gap_tolerance_nm   = 0.06
prior_lambda_nm    = 1.40
prior_lambda_sigma = 0.05

# -- Variance probes ----------------------------------------------------------

[variance]
print_results    = true
energy_var       = "energy.total  last 200  0.12"
displacement_var = "displacement  all  0.10"

# -- Export -------------------------------------------------------------------

[export]
write_xyz            = true
write_xyzf           = false
write_analysis_json  = true
write_metrics_tsv    = true
write_report_md      = true
write_summary_csv    = true
output_dir           = "out/wo74c_length_scale_fitter_demo"

# -- Visual -------------------------------------------------------------------

[visual]
output_type            = "terminal_chart"
render_interval        = 80
show_convergence_trace = true
show_bar_chart         = true
show_symbolic_trace    = false
animation_mode         = "static"
