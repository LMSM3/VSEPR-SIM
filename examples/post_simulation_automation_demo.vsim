# =============================================================================
# post_simulation_automation_demo.vsim
#
# Post-simulation automation example for VSIM scripting and desktop follow-up.
#
# Goal:
#   Run a small deterministic NVT job, then emit a compact post-run artifact set
#   that is easy to consume from automation or inspect from the desktop app.
#
# Automation outputs:
#   - static geometry             -> write_xyz
#   - replay / sampling frames    -> write_xyzf
#   - analysis summary            -> write_analysis_json
#   - metrics table               -> write_metrics_tsv
#   - markdown report             -> write_report_md
#   - event log                   -> write_events_json
#   - viewer/archive sidecar      -> .dynx when launched from desktop run panel
#
# Suggested usage:
#   vsper run examples/post_simulation_automation_demo.vsim
#
# Desktop follow-up:
#   Use the desktop Run VSIM panel to launch this script and inspect the output
#   directory artifacts after completion.
# =============================================================================

[project]
name        = "post_simulation_automation_demo"
version     = "v5.0.14"
seed_base   = 8401
determinism = true
description = "Small scripted post-simulation automation pipeline with viewer-friendly outputs"

[simulation]
box_size_ang     = 32.0
periodic         = false
fire_max_steps   = 120
fire_dt_fs       = 0.5
formation_preset = "molecular"
step_delay_ms    = 0

[[simulation.molecule]]
formula       = "H2O"
count         = 24
temperature_K = 298.0
lattice       = "none"

[environment]
temperature = 298.0
pressure    = 0.0
medium      = "vacuum"
periodic    = false

[run]
mode         = "md_nvt"
max_steps    = 240
dt_fs        = 0.5
temperature  = 298.0
converge     = true
output_level = "standard"

[analysis.structure]
enabled              = true
compute_coordination = true
compute_packing      = true
compute_displacement = true
neighbor_cutoff_A    = 3.4
contact_cutoff_A     = 2.0

[analysis.sampling]
enabled               = true
compute_rdf           = true
compute_msd           = true
min_frames_for_motion = 2
min_frames_for_msd    = 5
unwrap_pbc            = false

[analysis.inference]
enabled                    = true
mode                       = "rule_based_61d"
infer_packing_regime       = true
infer_mobility_regime      = true
infer_structural_stability = true
infer_macro_readiness      = false

[verify]
enabled = true

[verify.mass]
enabled   = true
max_drift = 1e-10

[export]
write_xyz            = true
write_xyzf           = true
write_analysis_json  = true
write_metrics_tsv    = true
write_report_md      = true
write_events_json    = true
output_dir           = "out/post_simulation_automation_demo"

[export.visual]
write_rdf_svg          = true
write_energy_trace_svg = true
write_html_dashboard   = false
visual_output_dir      = "figures"

[visual]
output_type            = "terminal_chart"
render_interval        = 30
show_convergence_trace = true
show_bar_chart         = false
show_symbolic_trace    = false
animation_mode         = "static"