# cmake_uninstall.cmake.in
# ========================
# Generated by CMake. Reads the install manifest and removes every installed
# file. Runs via:  cmake --build <dir> --target uninstall
#
# Sourced from cmake/VisBuild.cmake (install_manifest_files workaround for
# multi-component manifests is not needed here — single global manifest).

if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
	# CMake writes per-component manifests when --component is used.
	# Collect them all and merge.
	file(GLOB _component_manifests
		"@CMAKE_BINARY_DIR@/install_manifest_*.txt")
	if(NOT _component_manifests)
		message(WARNING "Cannot find install_manifest.txt or any install_manifest_*.txt — nothing to uninstall.")
		return()
	endif()
	set(_manifest_contents "")
	foreach(_m ${_component_manifests})
		file(READ "${_m}" _part)
		string(APPEND _manifest_contents "${_part}\n")
	endforeach()
else()
	file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" _manifest_contents)
endif()
string(REGEX REPLACE "\n" ";" _installed_files "${_manifest_contents}")

foreach(_file ${_installed_files})
	string(STRIP "${_file}" _file)
	if(_file STREQUAL "")
		continue()
	endif()
	if(EXISTS "${_file}")
		message(STATUS "Removing: ${_file}")
		file(REMOVE "${_file}")
	else()
		message(STATUS "Already gone: ${_file}")
	endif()
endforeach()

message(STATUS "Uninstall complete.")
