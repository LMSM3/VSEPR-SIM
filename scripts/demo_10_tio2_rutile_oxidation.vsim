# scripts/demo_10_tio2_rutile_oxidation.vsim
# =============================================================================
# VSEPR-SIM v5.0.2  |  Demo 10 — TiO2 rutile  |  ambient oxidation run
#
# Pipeline path:
#   [material]  TiO2 rutile 2×2×2 supercell
#   [run]       mode = "md"  NVT 600 K
#   [environment]  argon carrier gas, T=600 K
#   [chemistry] oxidation rule family, heat auto-derived from T
#   [observe]   reaction_events, exothermic_count, avg_delta_E
#   [export]    xyz, xyzf, analysis_json, report_md, dashboard_svg
#   [export.visual]  rdf_svg, energy_trace_svg, packing_heatmap_svg
#   [visual]    terminal_chart with proxy table + convergence trace
#   [variance]  energy probe — feeds [while] continuation guard
#   [while]     loop until energy variance < 0.05 (max 10 iterations)
#   [report]    material cards + metric tables
#
# Run:
#   vsper validate scripts/demo_10_tio2_rutile_oxidation.vsim
#   vsper run     scripts/demo_10_tio2_rutile_oxidation.vsim
#
# Seed structure:   examples/structures/tio2_rutile_unit_cell.xyz
# 3D visualisation: figures/demo_10/tio2_rutile_3d.svg
# =============================================================================

[project]
name        = "demo_10_tio2_rutile_oxidation"
version     = "v5.0.2"
seed_base   = 10001
determinism = true
description = "TiO2 rutile 2x2x2 supercell — ambient oxidation MD at 600 K"

# ── Material ──────────────────────────────────────────────────────────────────
# structure alias "rutile" resolves to prototype C4_TiO2 via RegistryResolver
# (WO-VSIM-03C).  space_group and basis are filled automatically.
[material]
formula     = "TiO2"
structure   = "rutile"
cell        = "2x2x2"
phase       = "solid"

# ── Run: NVT molecular dynamics ───────────────────────────────────────────────
[run]
mode          = "md"
max_steps     = 2000
dt_fs         = 0.5
temperature_K = 600.0
converge      = false
output_level  = "verbose"

# ── Explicit simulation box (matches 2×2×2 rutile supercell) ─────────────────
# a_super = 2 × 4.593 = 9.186 Å    c_super = 2 × 2.959 = 5.918 Å
[cell]
type  = "orthorhombic"
lx    = 9.186
ly    = 9.186
lz    = 5.918
units = "angstrom"

[boundary]
x = "periodic"
y = "periodic"
z = "periodic"

[pbc]
minimum_image        = true
wrap_positions       = "after_step"
track_images         = true
unwrap_for_diffusion = true

# ── Physical environment ──────────────────────────────────────────────────────
[environment]
periodic    = true
temperature = 600.0
pressure    = 0.0
medium      = "argon_gas"
field_x     = 0.0
field_y     = 0.0
field_z     = 0.0

# ── Ambient reaction chemistry ────────────────────────────────────────────────
# heat = -1  → auto-derive from environment.temperature (600 K → h ≈ 199)
[chemistry]
chemistry              = "oxidation"
heat                   = -1
reaction_events        = true
track_species_state    = true
min_score_threshold    = 0.25
max_reactions_per_step = 4

# ── Observables ───────────────────────────────────────────────────────────────
[observe]
metrics       = ["reaction_events", "exothermic_count", "avg_delta_E", "formation", "transport", "defect"]
output_format = "json"
every_n_steps = 50

# ── Variance probe — feeds [while] guard ──────────────────────────────────────
[variance]
energy_var = "energy.total" "last 100" 0.05

# ── While loop — continue until energy is settled ────────────────────────────
[while]
name         = "settle_energy"
condition    = "variance energy_var > 0.05"
body_steps   = 200
max_iters    = 10
measure      = ["energy_var"]
iter_delay_ms = 150

# ── Export ────────────────────────────────────────────────────────────────────
[export]
write_xyz                  = true
write_xyzf                 = true
write_analysis_json        = true
write_metrics_tsv          = true
write_events_json          = true
write_report_md            = true
write_dashboard_svg        = true
write_manifest_json        = true
write_pipeline_audit_jsonl = true
output_dir                 = "out/demo_10_tio2_rutile_oxidation"

[export.visual]
write_svg_figures          = true
write_rdf_svg              = true
write_energy_trace_svg     = true
write_packing_heatmap_svg  = true
visual_output_dir          = "figures/demo_10"

# ── Terminal display ──────────────────────────────────────────────────────────
[visual]
output_type              = "terminal_chart"
animation_mode           = "spark"
render_interval          = 50
show_proxy_table         = true
show_convergence_trace   = true
show_steady_state_marker = true
show_snapshot_chart      = true
show_event_timeline      = true
show_bar_chart           = true
show_symbolic_trace      = false
show_rdf_plot            = true
show_energy_heatmap      = false
show_audit_table         = false

# ── Report content ────────────────────────────────────────────────────────────
[report]
title                   = "TiO2 Rutile — Ambient Oxidation at 600 K"
include_material_cards  = true
include_metric_tables   = true
include_expected_trends = true
include_symbolic_trace  = false
