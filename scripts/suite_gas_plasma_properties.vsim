# scripts/suite_gas_plasma_properties.vsim
# =============================================================================
#  GENERIC GAS / PLASMA PROPERTIES SUITE
#  Run: VSEPR scripts/suite_gas_plasma_properties.vsim
# =============================================================================
#
#  Phase A  -  Ar monatomic noble gas  (512 atoms, NPT at 500 K / 1 atm)
#              Equation-of-state characterisation + radial structure + MSD
#
#  Phase B  -  N2 diatomic gas  (300 molecules = 600 atoms, NVE at 5000 K)
#              High-temperature partial ionisation proxy; vibrational spectral
#              sampling + bond-angle distribution + velocity autocorrelation
#
#  Purpose:
#    Maximum-sampling reference for low-density atomistic gas and plasma-
#    proxy simulations.  All observable, thermal-probe, and field-probe
#    surfaces are exercised.
#
#  Output tree:
#    out/gas_plasma_suite/
#      *.xyz, *.xyzf, *.xyzfull
#      analysis.json, metrics.tsv, events.jsonl, symbolic_trace.json
#      report.md, dashboard.svg, manifest.json
#      pipeline/  (structure, sampling, scale_sampling, inference JSONs)
#      verify/    (verify_report.json, verify_matrix.tsv)
#      figures/   (rdf, energy_trace, packing_heatmap, defect_map, cluster_map,
#                  overlay_cycle GIF, html_dashboard, report_html)
# =============================================================================

[project]
name        = "gas_plasma_suite"
version     = "v5.0.2"
seed_base   = 8100
description = "Ar noble gas + N2 high-temperature plasma-proxy dual-phase properties suite. Maximum-sampling reference."

[seed]
foundation = 8100
defect     = 8103
formation  = 8106
thermal    = 8108
placement  = 8111

# =============================================================================
#  PHASE A  -  Ar monatomic noble gas, 512 atoms, NPT
#  FCC-like random placement, box ~32 A at standard density
# =============================================================================

[material]
formula     = "Ar"
structure   = "fcc"
prototype   = "A1_Cu"
cell        = "8x8x8"
phase       = "gas"

[run]
mode          = "npt"
max_steps     = 5000
dt_fs         = 1.5
temperature   = 500
converge      = true
output_level  = "verbose"

[environment]
periodic    = true
temperature = 500
pressure    = 1.0
medium      = "vacuum"

[cell]
lx = 32.0
ly = 32.0
lz = 32.0
units = "angstrom"

[boundary]
x = "periodic"
y = "periodic"
z = "periodic"

[pbc]
minimum_image        = true
track_images         = true
unwrap_for_diffusion = true

[simulation]
fire_max_steps    = 2000
fire_dt_fs        = 0.48
box_size_ang      = 32.0
periodic          = true
formation_preset  = "gaseous"
use_ewald         = false
step_delay_ms     = 0

[[simulation.molecule]]
formula     = "Ar"
count       = 512
temperature = 500.0

# -- Phase B ------------------------------------------------------------------
# N2 high-temperature gas / plasma proxy
# 300 molecules = 600 atoms; NVE at 5000 K to probe vibrational excitation

[[simulation.molecule]]
formula        = "N2"
count          = 300
temperature    = 5000.0
region         = "upper_half"
velocity_drift = 0.05

# =============================================================================
#  KERNEL & TRACING
# =============================================================================

[kernel]
pass_through        = true
symbolic_trace      = true
event_registry      = true
continual_reporting = true

[kernel.trace]
formation_events = true
defect_events    = false
transport_events = true
layer_events     = false
dynamic_energy   = true

# =============================================================================
#  OBSERVE  -  full observable suite for gas / plasma
# =============================================================================

[observe]
metrics = [
  "energy_map",
  "coordination",
  "rdf",
  "msd",
  "displacement",
  "packing_fraction",
  "virial_stress",
  "diffusion_proxy",
  "spectral_response",
  "order_param",
  "phase_label",
  "pair_distribution",
  "cluster_count",
  "velocity_autocorr",
  "angular_distribution",
  "bond_angle",
  "cn_distribution",
  "thermal_conductivity_proxy",
  "radial_velocity",
  "ionisation_proxy",
  "vibrational_frequency"
]
output_format = "json"
every_n_steps = 20

# =============================================================================
#  THERMAL PROBE  -  regional temperature / heat-flux  (WO-OUTPUT-PHASE2)
# =============================================================================

[thermal_probe]
enabled                     = true
compute_gradient            = true
compute_heat_flux           = true
compute_conductivity_proxy  = true
compute_local_temperature   = true
compute_temperature_variance = true
compute_heat_capacity_proxy = true
every_n_steps               = 40
gradient_dx                 = 2.0
region_bins                 = 6
region                      = "all"
output_format               = "json"

# =============================================================================
#  FIELD PROBE  -  stress tensor / density field  (WO-OUTPUT-PHASE2)
# =============================================================================

[field_probe]
enabled                    = true
compute_stress_tensor      = true
compute_stress_eigenvalues = true
compute_von_mises          = true
compute_density_field      = true
compute_pressure_field     = true
compute_velocity_field     = true
compute_charge_density     = false
compute_electric_field     = false
every_n_steps              = 40
output_format              = "json"
write_vtp                  = false

# =============================================================================
#  VARIANCE PROBES
# =============================================================================

[variance]
print_results = true

energy_var       = "energy.total"  "last 100"  0.025
displacement_var = "displacement"  "last 100"  0.100
order_var        = "eta"           "last 100"  0.050
coord_var        = "coordination"  "last  50"  0.200

plasma_disp_var   = "displacement"  "last  50"  0.300
plasma_energy_var = "energy.total"  "last  50"  0.080

# =============================================================================
#  N_EVOLUTION PROBES
# =============================================================================

[N_evolution]
print_results = true

cluster_growth  = "cluster_count"  "last 80"  0.05
defect_growth   = "defect_count"   "last 80"  0.05
vapor_fraction  = "vapor"          "last 80"  0.02
ionised_frac    = "ionisation_proxy" "last 80" 0.01
event_rate      = "event_count"    "last 50"  0.0

# =============================================================================
#  WHILE LOOP  -  drive Ar phase toward equilibrium
# =============================================================================

[while]
name          = "ar_equilibrate"
condition     = "variance energy_var > 0.020"
max_iters     = 12
body_steps    = 500
measure       = [energy_var, displacement_var, order_var]
iter_delay_ms = 0

# =============================================================================
#  UNTIL LOOP  -  hold until plasma diffuses
# =============================================================================

[until]
name          = "plasma_diffuse"
condition     = "N_evolution vapor_fraction < 0.010"
max_iters     = 20
body_steps    = 250
measure       = [plasma_disp_var, vapor_fraction, event_rate]
iter_delay_ms = 0
export_each   = false

# =============================================================================
#  SMART LOOP  -  temperature ramp across both phases
# =============================================================================

[loop]
name           = "phase_temperature_ramp"
iterations     = 140
body_steps     = 400
stop_condition = "variance energy_var < 0.004"
record_each    = true
export_each    = true
rand_seed      = 8101
perturb_mode   = "combo"

# Ar ramp: 300 K -> 800 K
var = "temperature       start=300   stop=800   delta=35.7   mode=linear"
var = "pressure          start=1.0   stop=5.0   delta=0.0    mode=random  noise=0.1"

# N2 / plasma ramp: 3000 K -> 8000 K
var = "steam_temperature start=3000  stop=8000  delta=357.0  mode=combo   noise=50.0"

# Ionisation probe
var = "defect_rate  start=0.00  stop=0.20  delta=0.015  mode=combo  noise=0.003"

# =============================================================================
#  ANALYSIS PIPELINE
# =============================================================================

[analysis.sampling]
enabled               = true
compute_rdf           = true
compute_msd           = true
min_frames_for_motion = 2
min_frames_for_msd    = 10
unwrap_pbc            = true

[analysis.scale_sampling]
enabled                          = true
compute_field_projection         = true
compute_rve_sampling             = true
compute_emergence_metrics        = true
field_grid                       = [8, 8, 8]
min_particles_for_scale_sampling = 32
rve_windows_per_level            = 16
rve_window_placement             = "stratified"
temporal_drift_metric            = "block_difference"
scale_drift_metric               = "successive_window_difference"
spatial_cv_threshold             = 0.20
temporal_drift_threshold         = 0.10
scale_drift_threshold            = 0.15

[analysis.structure]
enabled = true

[analysis.inference]
enabled                         = true
mode                            = "rule_based_61d"
infer_packing_regime            = true
infer_mobility_regime           = true
infer_anisotropy_regime         = true
infer_structural_stability      = true
infer_macro_readiness           = false
min_particles_macro_candidate   = 64
min_frames_macro_candidate      = 10
minimum_available_metrics_for_macro_ready = 3

# =============================================================================
#  VERIFICATION
# =============================================================================

[verify.structure]
enabled                     = true
expected_prototype          = "A1_Cu"
expected_coordination       = 12
coordination_tolerance      = 3
expected_nearest_neighbor_A = 3.76
nearest_neighbor_tolerance_A = 0.30
expected_density_relation   = "ar_gas_500K"

[verify.rdf]
enabled                  = true
expected_first_peak_A    = 3.76
first_peak_tolerance_A   = 0.40
expected_second_peak_A   = 5.31
second_peak_tolerance_A  = 0.50

[verify.msd]
enabled              = true
expect_bounded_solid = false
max_msd_A2           = 500.0
max_slope_late       = 2.0
expect_regime        = "gas_diffusive"

[verify.mass]
enabled            = true
relative_tolerance = 1e-9

# =============================================================================
#  EXPORT
# =============================================================================

[export]
write_xyz                    = true
write_xyzf                   = true
write_xyzfull                = true
write_pdb                    = true
write_analysis_json          = true
write_metrics_tsv            = true
write_cluster_json           = true
write_fingerprint_json       = true
write_events_json            = true
write_symbolic_trace_json    = true
write_report_md              = true
write_summary_csv            = true
write_dashboard_json         = true
write_manifest_json          = true
write_dashboard_svg          = true
write_pipeline_audit_jsonl   = true
write_step_file              = false
write_vtp_mesh               = true
output_dir = "out/gas_plasma_suite"

[output]
output_dir    = "out/gas_plasma_suite/pipeline"
output_prefix = "gas_plasma"
write_structure_json      = true
write_sampling_json       = true
write_scale_sampling_json = true
write_inference_json      = true
write_sampling_manifest   = true

# =============================================================================
#  VISUAL EXPORTS
# =============================================================================

[export.visual]
write_svg_figures          = true
write_png_snapshots        = true
write_rdf_svg              = true
write_energy_trace_svg     = true
write_packing_heatmap_svg  = true
write_defect_map_svg       = false
write_cluster_map_svg      = true
write_trajectory_gif       = true
write_overlay_cycle_gif    = true
gif_frame_skip             = 25
gif_delay_cs               = 5
write_html_dashboard       = true
write_report_html          = true
write_report_pdf           = false
visual_output_dir = "out/gas_plasma_suite/figures"

# =============================================================================
#  INTERACTIVE DISPLAY
# =============================================================================

[visual]
output_type              = "terminal_overlay_cycle"
animation_mode           = "overlay"
render_interval          = 50
show_proxy_table          = true
show_convergence_trace    = true
show_steady_state_marker  = true
show_snapshot_chart       = true
show_event_timeline       = true
show_bar_chart            = true
show_symbolic_trace       = true
show_animation_cues       = true
show_audit_table          = true
show_rdf_plot             = true
show_energy_heatmap       = true
show_defect_map           = false
show_phase_field          = true
show_bond_events          = false
show_charge_overlay       = false
show_velocity_vectors     = true
overlay_sequence  = "density,coordination,memory,orient_order"
gl_overlay_hold_s = 2.5
gl_auto_orbit     = true
gl_window_width   = 1440
gl_window_height  = 900

[visual.external]
enabled          = true
render_interval  = 100
export_format    = "svg"
show_progress    = true

# =============================================================================
#  REPORT
# =============================================================================

[report]
title                  = "gas_plasma_suite"
include_material_cards = true