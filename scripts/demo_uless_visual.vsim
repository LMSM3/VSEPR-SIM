# scripts/demo_uless_visual.vsim
# Demonstrates the Uless observation-length indicator in the VTK + Qt3D viewer.
# The viewer target requires Qt6 Qt3D, which is currently unavailable in this
# toolchain, so this script verifies the pipeline end-to-end up to the launcher.
#
# Run:  vsepr run scripts/demo_uless_visual.vsim
# The CLI will flag the explicit Qt3D blocker if the viewer cannot be built.

[project]
name        = demo_uless_visual
version     = v5.14.1
seed_base   = 8901
determinism = true

[kernel]
pass_through     = true
symbolic_trace   = true
continual_reporting = true

[simulation.molecule]
formula     = C6H12
count       = 1
temperature = 300.0
lattice     = none

[simulation]
fire_max_steps = 200
fire_dt_fs     = 1.0
box_size_ang   = 30.0
periodic       = false
formation_preset = organic

[export]
write_xyz           = true
write_xyzf          = true
write_analysis_json = false
write_metrics_tsv   = false
write_report_md     = false
write_events_json   = false

[visual]
output_type              = terminal_chart
animation_mode           = spark
show_proxy_table         = false
show_convergence_trace   = false
show_steady_state_marker = true
show_snapshot_chart      = false
show_event_timeline      = false
show_bar_chart           = false
show_symbolic_trace      = false
show_audit_table         = false

# Uless indicator configuration (WO-89 Uless visual)
uless_indicator_enabled = true
uless_indicator_label   = obs
uless_indicator_value   = 0.75
uless_indicator_max     = 1.00

[open]
enabled = true
