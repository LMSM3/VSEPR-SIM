#                                   # DEFERRED WO-84B: ElementLonePairProvider
#                                   # must cover Xe, Kr, Rn, d/f-block before
#                                   # this field has real effect
#
# [classify.expect]
# contains = "vsepr_report"
# contains = "site["
# result   = PASS
