# DEPRECATED: small or non-visual script moved during vsim_scripts consolidation.
# Class: deprecated
#
# =============================================================================
# audit_day68_smf_force_channels.vsim
# VSEPR-SIM Day #68 — Audit Script 3 (implement last; highest-risk physics)
#
# Target:
#   Validate SMF-MD force-channel toggles and Dynx force-channel logging.
#
# Audit focus:
#   - ForceChannel enum resolution
#   - kernel.channel.enable / disable / reset
#   - SState schema presence
#   - FieldSample schema presence
#   - Dynx frame emission
#   - force-channel sum consistency:  sum_k F_i,k = F_i,total
#   - disabled channel zero contribution
#   - no NaN / no Inf energy
#
# Unique audit target:
#   sum_k F_i,k = F_i,total   (force-channel sum consistency)
#
# VSIM_REFERENCE: WO-VSIM-DAY68-AUDIT / Group 72
# =============================================================================

[project]
name        = "audit_day68_smf_force_channels"
version     = "v5.1.X-day68"
seed_base   = 68001
determinism = true
description = "Day #68 SMF-MD force-channel gate audit"

[system]
type     = "particle_pair"
species  = ["Na", "Cl"]
positions = [
	[0.000, 0.000, 0.000],
	[2.820, 0.000, 0.000]
]
units.length = "angstrom"
units.energy = "eV"
units.time   = "fs"

[kernel]
model         = "smf_md_v1"
integrator    = "velocity_verlet_state"
dt            = 0.001
steps         = 1000
deterministic = true
seed          = 68001

[kernel.trace]
enabled              = true
interval             = 10
write_force_channels = true
write_energy_terms   = true
write_state          = true
write_fields         = true

[state_schema]
model   = "S_state_v1"
enabled = true
fields  = [
	"mass",
	"charge",
	"density",
	"temperature",
	"internal_energy",
	"stress",
	"strain",
	"reaction",
	"damage",
	"phase",
	"activity"
]

[field_schema]
model   = "field_bundle_v1"
enabled = true
fields  = [
	"electric",
	"magnetic",
	"gravity",
	"temperature",
	"pressure",
	"radiation"
]

[interactions]
repulsion  = 0.0
dispersion = 0.0
coulomb    = 0.0
bond       = 0.0
angle      = 0.0
torsion    = 0.0
field      = 0.0
state      = 0.0
radiation  = 0.0
damage     = 0.0
constraint = 0.0

[export]
dynx        = true
xbit        = false
summary_csv = true
report      = true

[report]
enabled            = true
format             = "markdown"
title              = "Day #68 SMF-MD Force Channel Audit"
include_validation = true
include_artifacts  = true

[script]
const channels = [
	"repulsion",
	"dispersion",
	"coulomb",
	"bond",
	"field",
	"state",
	"radiation",
	"damage",
	"constraint"
]

const ramps = [0.0, 0.25, 0.50, 0.75, 1.0]

require(kernel.model == "smf_md_v1")
require(state_schema.enabled == true)
require(field_schema.enabled == true)

artifact.manifest.write("out/day68_force_channels/manifest.json")
artifact.report.prepare("out/day68_force_channels/report.md")

for ch in channels {

	gate.begin("channel_resolution_${ch}")

	kernel.channel.reset()
	kernel.channel.enable(ch, weight = 1.0)

	kernel.trace.enable(profile = "force_debug")

	artifact.dynx.enable(profile = "smf_force_gate")
	artifact.dynx.include("positions")
	artifact.dynx.include("velocities")
	artifact.dynx.include("accelerations")
	artifact.dynx.include("S_state")
	artifact.dynx.include("field_samples")
	artifact.dynx.include("force_channels")
	artifact.dynx.include("energy_terms")
	artifact.dynx.include("events")

	runtime.run_case("single_channel_${ch}")

	metrics.capture()

	gate.assert(metrics.energy.has_nan == false)
	gate.assert(metrics.energy.has_inf == false)
	gate.assert(metrics.force.channel_sum_error < 1e-9)
	gate.assert(metrics.force.disabled_channels_zero == true)
	gate.assert(metrics.force.enabled_channel_nonzero_or_declared_inactive == true)

	artifact.dynx.validate()
	artifact.dynx.export("out/day68_force_channels/${ch}/run.dynx")

	metrics.export("out/day68_force_channels/${ch}/metrics.tsv")
	artifact.report.append_gate_summary()

	gate.end()
}

for ch in channels {
	for w in ramps {

		gate.begin("channel_ramp_${ch}_${w}")

		kernel.channel.reset()
		kernel.channel.enable(ch, weight = w)

		artifact.dynx.enable(profile = "smf_force_ramp")
		artifact.dynx.include("force_channels")
		artifact.dynx.include("energy_terms")

		runtime.run_case("ramp_${ch}_${w}")

		metrics.capture()

		gate.assert(metrics.force.channel_sum_error < 1e-9)
		gate.assert(metrics.energy.has_nan == false)
		gate.assert(metrics.energy.has_inf == false)

		if w == 0.0 {
			gate.assert(metrics.force.enabled_channel_total_norm < 1e-12)
		}

		artifact.dynx.validate()
		artifact.dynx.export("out/day68_force_channels/ramps/${ch}_${w}/run.dynx")

		gate.end()
	}
}

artifact.report.write()
artifact.manifest.finalize()

