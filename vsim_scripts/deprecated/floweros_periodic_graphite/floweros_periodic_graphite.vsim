# DEPRECATED: small or non-visual script moved during vsim_scripts consolidation.
# Class: deprecated
#
[project]
name        = "floweros_periodic_graphite"
version     = "v5.14.1"
seed_base   = 13002
determinism = true
description = "Periodic five-layer AB graphite cell with tracked images"

[simulation]
fire_max_steps   = 120
fire_dt_fs       = 0.5
periodic         = true
formation_preset = "metal"
use_ewald        = false

[[simulation.molecule]]
formula     = "C"
count       = 120
temperature = 300.0
lattice     = "hexagonal"
layer_mode  = "AB"
n_layers    = 5

[cell]
type  = "orthorhombic"
lx    = 36.0
ly    = 36.0
lz    = 28.0
units = "angstrom"

[boundary]
x = "periodic"
y = "periodic"
z = "periodic"

[pbc]
minimum_image        = true
wrap_positions       = "after_step"
track_images         = true
unwrap_for_diffusion = true

[environment]
temperature = 300.0
pressure    = 1.0
medium      = "vacuum"
periodic    = true

[run]
mode         = "md_nvt"
max_steps    = 80
dt_fs        = 0.25
temperature  = 300.0
converge     = true
output_level = "standard"

[analysis.structure]
enabled              = true
compute_coordination = true
compute_packing      = true
compute_displacement = true
neighbor_cutoff_A    = 3.0
contact_cutoff_A     = 2.0

[analysis.sampling]
enabled               = true
compute_rdf           = true
compute_msd           = true
min_frames_for_motion = 2
min_frames_for_msd    = 5
unwrap_pbc             = true

[export]
write_xyz           = true
write_xyzf          = true
write_analysis_json = true
write_metrics_tsv   = true
write_events_json   = true
output_dir          = "out/floweros_periodic_graphite"

[visual]
output_type            = "terminal_chart"
render_interval        = 20
show_convergence_trace = true
animation_mode         = "static"

