# DEPRECATED: small or non-visual script moved during vsim_scripts consolidation.
# Class: deprecated
#
[project]
name = "wire_path_transport_geometry"
version = "v5.1.x"
seed_base = 7204
determinism = true
description = "Bent conductor generated from path geometry with transport-style observables."

[seed]
foundation = 7204
placement = 18204
thermal = 15204

[material]
formula = "Cu"
structure = "fcc"
phase = "solid"
cell = "4x4x4"

[run]
mode = "md"
max_steps = 6000
dt_fs = 0.5
temperature_K = 350.0
converge = true
output_level = "verbose"

[environment]
periodic = false
temperature = 350.0
pressure = 0.0
medium = "vacuum"
field_x = 0.05
field_y = 0.00
field_z = 0.00

[cell]
lx = 80.0
ly = 50.0
lz = 30.0
units = "angstrom"

[boundary]
x = "open"
y = "open"
z = "open"

[objects]
wire.centerline = "path:[[0,0,0],[20,0,0],[30,10,0],[30,25,5],[45,25,5]]"
wire.body = "pipe:radius=2.0,length=55.0,material=copper"
wire.surface = "wall:geometry=wire.body"

[populate.wire]
target = "wire.body"
species = "Cu"
method = "path_sweep"
spacing_A = 2.55
radial_layers = 4
axial_jitter = 0.02
radial_jitter = 0.01
infer_count_from_geometry = true
infer_mass_from_element = true
infer_density_from_population = true

[excite.electric_field]
axis = "x"
polarization = "x"
intensity = 1.0
pulse_width_fs = 500.0
photon_energy_eV = 0.0
fluence = 0.0
profile = "flat"

[chemistry]
chemistry = "none"
heat = -1
reaction_events = true
track_species_state = false
event_registry = true
min_score_threshold = 0.25
max_reactions_per_step = 0

[analysis.structure]
enabled = true

[analysis.sampling]
enabled = true
compute_rdf = true
compute_msd = true

[analysis.scale_sampling]
enabled = true
compute_field_projection = true
compute_rve_sampling = true
compute_emergence_metrics = true
field_grid = [10, 6, 4]
rve_window_lengths_A = [4.0, 8.0, 12.0]
rve_windows_per_level = 8
rve_window_placement = "stratified"
min_particles_for_scale_sampling = 64

[analysis.inference]
enabled = true
mode = "rule_based_61d"

[observe]
metrics = ["transport", "energy_map", "formation"]
output_format = "json"
every_n_steps = 20

[verify]
enabled = true
profile = "copper_wire_geometry_transport_proxy"
write_verify_report = true
write_verify_tsv = true

[verify.mass]
enabled = true
relative_tolerance = 1e-10

[export]
write_xyz = true
write_xyzf = true
write_xyzfull = true
write_analysis_json = true
write_metrics_tsv = true
write_events_json = true
write_symbolic_trace_json = true
write_report_md = true
write_dashboard_json = true
write_manifest_json = true
write_step_file = true
output_dir = "out/wire_path_transport_geometry"

[export.visual]
write_svg_figures = true
write_energy_trace_svg = true
write_packing_heatmap_svg = true
write_html_dashboard = true
write_report_html = true
visual_output_dir = "figures"

[visual]
output_type = "terminal_energy_heatmap"
animation_mode = "bar"
render_interval = 20
show_proxy_table = true
show_convergence_trace = true
show_energy_heatmap = true
show_event_timeline = true
