# scripts/vsim_skeletons/wo83n_lipid_score.vsim
# Tier A — native replacement for demo_wo83n_lipid_like_score.py
# STUB: [classify] block awaits vsim_parser.cpp wiring (WO-84A)
# STUB: [classify.compare] cross-formula numeric ordering not in VSIM language yet.
#
# The Python script extracts lipid_like_score via regex and asserts ordering:
#   score(C16H34) > score(CH4)
#   score(C2N4O4) <= score(C16H34)
#
# A native VSIM equivalent would need a [classify.compare] section to express
# cross-formula ordering assertions — not yet designed.
# Individual threshold checks ARE expressible once [classify.expect] is wired.

[project]
name    = wo83n_lipid_score_c16h34
version = v5.0.0

[material]
formula = C16H34

